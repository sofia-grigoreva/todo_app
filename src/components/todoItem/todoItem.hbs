{{#if isEditing}}
<li id="todoItem-{{id}}" class="editing">
  <input id="todo-input-{{id}}" type="text" class="edit-input" value="{{text}}" style="color: {{color}};">
  <button class="save-btn">Save</button>
  <button class="cancel-btn">Cancel</button>
</li>
{{else}}
<li id="todoItem-{{id}}">
  <span class="todo-text" style="color: {{color}};">{{text}}</span>
  <button class="done-btn">Done</button>
</li>
{{/if}}